# Copy to .env and load into your shell/IDE before running.
DB_URL=jdbc:postgresql://localhost:5432/school_wallet
DB_USER=school_wallet
DB_PASSWORD=school_wallet
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
DATA_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173

# Bootstrap super admin (used once, then ignored). Change before first run.
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_PHONE=+255700000000
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME=KADE Super Admin
