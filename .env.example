# Copy to .env for local overrides. Compose works without this file using
# local-only defaults, but change these values before exposing the app.
DB_NAME=school_wallet
DB_USER=school_wallet
DB_PASSWORD=change-this-local-db-password

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
CORS_ORIGINS=http://localhost:8085

# Demo dataset is seeded on an empty database and never overwrites changes.
BOOTSTRAP_ENABLED=true
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=LocalAdmin123!
SUPER_ADMIN_PHONE=+255700000000
SUPER_ADMIN_FULL_NAME=Skulify Super Admin
API_DOCS_ENABLED=false
